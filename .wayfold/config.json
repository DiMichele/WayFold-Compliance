{
  "schemaVersion": 2,
  "mode": "LOCAL_OVERNIGHT",
  "cloudAutomationConfigured": false,
  "cursorCommand": "agent",
  "model": "",
  "sandbox": "disabled",
  "agentTimeoutSeconds": 14400,
  "maxAutomaticFixAttempts": 3,
  "maxPhase": 6,
  "delayBetweenAgentsSeconds": 2,
  "lockStaleSeconds": 21600,
  "autoCommit": true,
  "autoPush": true,
  "autoTag": true,
  "autoMergeMain": true,
  "autoDeploy": true,
  "autoDeploySetupTls": true,
  "productionUrl": "https://compliance.wayfold.xyz/api/health/",
  "allowDirtyStart": false,
  "preflightIgnoreUntrackedOther": true,
  "allowProtectedBranch": false,
  "reuseExistingFeatureBranch": true,
  "protectedBranches": ["main", "master"],
  "automationBranch": "automation/wayfold-compliance",
  "mainBranch": "main",
  "commonPrompt": "apps/wayfold-compliance/prompts/common.md",
  "transitions": [
    "1_TO_2",
    "2_TO_3",
    "3_TO_4",
    "4_TO_5",
    "5_TO_6",
    "CLOSE_6"
  ],
  "phases": [
    {
      "number": 1,
      "name": "Working Core",
      "developPrompt": "apps/wayfold-compliance/prompts/phase-01-develop.md",
      "verifyPrompt": "apps/wayfold-compliance/prompts/phase-01-verify.md",
      "fixPrompt": "apps/wayfold-compliance/prompts/common-fix.md"
    },
    {
      "number": 2,
      "name": "Unified Compliance",
      "developPrompt": "apps/wayfold-compliance/prompts/phase-02-develop.md",
      "verifyPrompt": "apps/wayfold-compliance/prompts/phase-02-verify.md",
      "fixPrompt": "apps/wayfold-compliance/prompts/common-fix.md"
    },
    {
      "number": 3,
      "name": "Consultant UX",
      "developPrompt": "apps/wayfold-compliance/prompts/phase-03-develop.md",
      "verifyPrompt": "apps/wayfold-compliance/prompts/phase-03-verify.md",
      "fixPrompt": "apps/wayfold-compliance/prompts/common-fix.md"
    },
    {
      "number": 4,
      "name": "Regulatory Intelligence",
      "developPrompt": "apps/wayfold-compliance/prompts/phase-04-develop.md",
      "verifyPrompt": "apps/wayfold-compliance/prompts/phase-04-verify.md",
      "fixPrompt": "apps/wayfold-compliance/prompts/common-fix.md"
    },
    {
      "number": 5,
      "name": "AI Assistance",
      "developPrompt": "apps/wayfold-compliance/prompts/phase-05-develop.md",
      "verifyPrompt": "apps/wayfold-compliance/prompts/phase-05-verify.md",
      "fixPrompt": "apps/wayfold-compliance/prompts/common-fix.md"
    },
    {
      "number": 6,
      "name": "Automated Evidence",
      "developPrompt": "apps/wayfold-compliance/prompts/phase-06-develop.md",
      "verifyPrompt": "apps/wayfold-compliance/prompts/phase-06-verify.md",
      "fixPrompt": "apps/wayfold-compliance/prompts/common-fix.md"
    }
  ]
}
