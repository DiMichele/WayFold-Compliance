# WayFold Compliance — template ambiente LOCALE
# Copia in .env e adatta. Non committare .env (è in .gitignore).
#
# Uso tipico locale: open access + demo seed (nessun login obbligatorio).
# Apri poi: http://127.0.0.1:8092/portfolio?superuser=1

# Non impostare production in locale
# WAYFOLD_ENV=production

WAYFOLD_OPEN_ACCESS=1
WAYFOLD_ALLOW_QS_AUTH=1
WAYFOLD_SEED_DEMO=1
WAYFOLD_MFA_ENFORCE=0

# Opzionale: directory dati (default = engine/data/)
# WAYFOLD_DATA_DIR=

# Solo se usi /login invece di open access:
# WAYFOLD_OPEN_ACCESS=0
# WAYFOLD_ALLOW_QS_AUTH=0
# WAYFOLD_AUTH_USER=admin
# WAYFOLD_AUTH_PASSWORD=cambia-questa-password
# WAYFOLD_SESSION_SECRET=genera-una-stringa-lunga-casuale

# Feature avanzate (default off anche in locale)
WAYFOLD_FEATURE_AI=0
WAYFOLD_FEATURE_FW_SUGGESTIONS=0
WAYFOLD_FEATURE_CONNECTORS=0
WAYFOLD_FEATURE_AUTO_EVIDENCE=0
